# Copia este archivo a .env y rellena las claves reales.
# El .env nunca debe subirse al control de versiones (está en .gitignore).
# En producción usa EAS Secrets: https://docs.expo.dev/eas/eas-json/#secrets

# ── Google APIs ──────────────────────────────────────────────────────────────
# Clave única para Google Maps SDK, Places API y Geocoding API.
# Habilita en Google Cloud Console:
#   - Maps SDK for Android / iOS
#   - Places API
#   - Geocoding API
# Restricciones recomendadas: limitar a bundle id (iOS) / package (Android).
GOOGLE_API_KEY=

# ── esbiblica.com ────────────────────────────────────────────────────────────
# API key opcional para api.esbiblica.com.
# Si la API no requiere autenticación, deja esta variable vacía.
ESBIBLICA_API_KEY=

# ── Anthropic Claude API ─────────────────────────────────────────────────────
# Usado para generar citas inspiradoras del Evangelio del día.
# ADVERTENCIA: en producción, las llamadas a Claude deben ir a través de tu
# propio backend para no exponer esta clave en el bundle de la app.
# Obtén la clave en: https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── EAS (Expo Application Services) ─────────────────────────────────────────
# Obtén el projectId en: https://expo.dev
EAS_PROJECT_ID=
