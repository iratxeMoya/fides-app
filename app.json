{
  "expo": {
    "name": "Fides",
    "slug": "fides-app",
    "version": "1.2.2",
    "scheme": "fides",
    "orientation": "portrait",
    "icon": "./assets/icons/fides_icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fides.app"
    },
    "android": {
      "package": "com.fides.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/icons/fides_icon.png",
          "color": "#FF7D7D",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "bfc111cc-eabb-4a7e-9051-a07ceefbc4c0"
      }
    }
  }
}